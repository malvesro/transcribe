FROM python:3.10-slim AS builder

# Define o diretório de trabalho
WORKDIR /app

# Instala dependências em um ambiente virtual para isolamento
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copia apenas o arquivo de requisitos primeiro para aproveitar o cache do Docker
COPY requirements.txt .

# Instala as dependências Python
RUN pip install --no-cache-dir -r requirements.txt

# Estágio 2: Final - Criar a imagem de produção
FROM python:3.10-slim

# Define o diretório de trabalho
WORKDIR /app

# Cria o usuário e garante que ele seja o dono do WORKDIR
RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

# Define o PATH para usar o ambiente virtual
ENV PATH="/opt/venv/bin:$PATH"

# Copia o ambiente virtual com as dependências do estágio de build
COPY --from=builder --chown=appuser:appuser /opt/venv /opt/venv

# Copia o resto do código da aplicação
COPY --chown=appuser:appuser . .

# Expõe a porta
EXPOSE 5000

# Comando para rodar a aplicação com Gunicorn
# Usamos 4 workers e um timeout de 120s. Ajuste conforme necessário.
CMD ["gunicorn", "--workers", "4", "--timeout", "120", "--bind", "0.0.0.0:5000", "app:app"]
