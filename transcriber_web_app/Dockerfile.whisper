# Estágio 1: Build
FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04 AS builder

# Define o frontend do apt para não interativo, evitando prompts durante o build.
ENV DEBIAN_FRONTEND=noninteractive

# Define o diretório de trabalho
WORKDIR /app

# Instala apenas o necessário para build e cache do modelo
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3.10-venv \
    python3-pip \
    ffmpeg \
    git \
    && python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --timeout 1200 --retries 5 torch --index-url https://download.pytorch.org/whl/cu121 \
    && /opt/venv/bin/pip install --no-cache-dir --timeout 1200 --retries 5 torchvision --index-url https://download.pytorch.org/whl/cu121 \
    && /opt/venv/bin/pip install --no-cache-dir --timeout 1200 --retries 5 torchaudio --index-url https://download.pytorch.org/whl/cu121 \
    && /opt/venv/bin/pip install --no-cache-dir --timeout 1200 --retries 5 -U openai-whisper \
    && /opt/venv/bin/python -c "import whisper; whisper.load_model('small')" \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Copia o script de transcrição para o diretório de trabalho
COPY transcribe.py /app/transcribe.py

# Estágio 2: Runtime
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

# Define o diretório de trabalho
WORKDIR /app

# Usuário não-root
RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

# Atualiza o PATH para incluir o diretório do ambiente virtual
ENV PATH="/opt/venv/bin:$PATH"

# Copia o ambiente virtual, script e cache do modelo da imagem de build
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app/transcribe.py /app/transcribe.py
COPY --from=builder /root/.cache/whisper /home/appuser/.cache/whisper

# Define o diretório de trabalho para a pasta de dados
WORKDIR /data

# Comando padrão para manter o container ativo
CMD ["tail", "-f", "/dev/null"]