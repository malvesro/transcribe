# Estágio 1: Build - Usar a imagem 'devel' para compilar dependências
FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Instalar dependências do sistema e criar ambiente virtual
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3.10-venv \
    ffmpeg \
    git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && python3.10 -m venv $VIRTUAL_ENV

# Instalar dependências Python no ambiente virtual
RUN pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121
RUN pip install --no-cache-dir -U openai-whisper


# Estágio 2: Final - Usar a imagem 'runtime', que é muito menor
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Instalar apenas as dependências de runtime necessárias
RUN apt-get update && apt-get install -y \
    python3.10 \
    ffmpeg \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copiar o ambiente virtual com as dependências pré-instaladas do estágio de build
COPY --from=builder $VIRTUAL_ENV $VIRTUAL_ENV

# Copiar o script da aplicação
WORKDIR /app
COPY transcribe.py .

# Pré-carregar o modelo Whisper na imagem final para acelerar o primeiro uso
RUN python3 -c "import whisper; print('Baixando e cacheando o modelo small...'); whisper.load_model('small'); print('Modelo small cacheado com sucesso.')"

# Definir o diretório de trabalho padrão para a pasta de dados
WORKDIR /data

# Comando para manter o container ativo, aguardando comandos
CMD ["tail", "-f", "/dev/null"]
