# Configurações do Whisper Transcriber
# Copie este arquivo para .env e ajuste os valores conforme necessário

# Ambiente da aplicação (development ou production)
FLASK_ENV=development

# Nome do projeto Docker Compose (usado para identificar containers)
COMPOSE_PROJECT_NAME=transcribe

# Chave secreta para Flask (gere uma chave segura para produção)
SECRET_KEY=dev-secret-change-in-production

# Limite máximo de tamanho de arquivo em GB
# Padrão: 15GB - Ajuste conforme sua necessidade e capacidade do servidor
# Exemplos:
# - Para arquivos pequenos: MAX_FILE_SIZE_GB=5
# - Para arquivos grandes: MAX_FILE_SIZE_GB=50
# - Para uso corporativo: MAX_FILE_SIZE_GB=100
MAX_FILE_SIZE_GB=15

# Configurações opcionais avançadas
# Timeout para transcrições em segundos (padrão: 3600 = 1 hora)
# TRANSCRIPTION_TIMEOUT=7200

# Intervalo de polling para status em milissegundos (padrão: 5000 = 5 segundos)
# STATUS_POLL_INTERVAL=3000