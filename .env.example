# Nome do projeto para o Docker Compose. Mantenha o padrão a menos que tenha conflitos.
COMPOSE_PROJECT_NAME=transcribe

# Ambiente da aplicação ('development' para depuração, 'production' para uso normal)
FLASK_ENV=production

# Chave secreta para a segurança das sessões do Flask.
# Em produção, altere para um valor aleatório longo.
# Você pode gerar uma com: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=change-this-in-production-to-a-long-random-string

# Limite máximo para o tamanho de arquivos enviados (em Gigabytes).
MAX_FILE_SIZE_GB=15

# Tempo máximo que uma transcrição pode levar (em segundos). Padrão: 1 hora.
TRANSCRIPTION_TIMEOUT=3600

# Intervalo em que a interface busca atualizações de status (em milissegundos).
STATUS_POLL_INTERVAL=3000
